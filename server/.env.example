PORT=5000
NODE_ENV=development

# MongoDB connection
MONGODB_URI=

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d

# Client URL
CLIENT_URL=http://localhost:5173

# AI provider settings
# Keep existing variable names: AI_PROVIDER=gemini to enable real Gemini calls
AI_PROVIDER=mock
# Use either AI_API_KEY or GEMINI_API_KEY for the server-side key
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite

# Optional: allow fallback to mock when provider fails
AI_FALLBACK_TO_MOCK=true

# Rate limiter override for analyze endpoint
AI_RATE_LIMIT_DISABLED=false
ANALYZE_RATE_LIMIT_MAX=3
ANALYZE_RATE_LIMIT_WINDOW_MS=60000

# Max transcript length
MAX_TRANSCRIPT_LENGTH=100000
PORT=5000
NODE_ENV=development

MONGODB_URI=your_mongodb_connection_string_here

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

CLIENT_URL=http://localhost:5173

AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

MAX_TRANSCRIPT_LENGTH=100000
